# Copy to .env.local for local development. Never commit real .env files.
#
# WARNING: every VITE_* variable is compiled into the public JavaScript that
# every visitor downloads. Only put PUBLIC values here — never API keys,
# tokens, passwords or database strings. Secrets belong on the server.

# Public base URL of the inquiry API (must be https in production).
# Leave empty to post to the same origin.
VITE_API_URL=
